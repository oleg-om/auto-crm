PORT=8090
NODE_ENV=dev
APP="Autodom CRM"
ENABLE_SOCKETS=true
MONGO_URL="mongodb+srv://..."
# Required - signs the login JWT. server/config.js falls back to a hardcoded
# default if this is unset, which lets anyone forge a valid token for any
# account (including admin). Generate with: openssl rand -hex 48
SECRET_JWT="..."
# Shared secret the external site sends as the `x-api-key` header when
# posting to public endpoints (e.g. POST /api/v1/tyre) without a CRM login.
EXTERNAL_API_KEY="..."
